        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="CREATE_DYNAMICDEPOSITPRODUCT"/>
            <column name="entity_name" value="DYNAMICDEPOSITPRODUCT"/>
            <column name="action_name" value="CREATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="CREATE_DYNAMICDEPOSITPRODUCT_CHECKER"/>
