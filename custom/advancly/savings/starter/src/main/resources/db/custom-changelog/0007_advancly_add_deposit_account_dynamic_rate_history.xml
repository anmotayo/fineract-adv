<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Dynamic Deposit rate history: one row per principal-changing transaction, capturing the interest rate -->
    <!-- resolved (or carried forward) for the interval starting at that transaction. Implementation plan Section 4. -->
    <changeSet author="advancly" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_deposit_account_dynamic_rate_history"/>
            </not>
        </preConditions>
        <createTable tableName="m_deposit_account_dynamic_rate_history">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_deposit_account_dynamic_rate_history"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="savings_account_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="invested_amount_after_transaction" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="deposit_period" type="INT"/>
            <column name="deposit_period_frequency_enum" type="INT"/>
            <column name="interest_rate_chart_id" type="BIGINT"/>
            <column name="interest_rate_slab_id" type="BIGINT"/>
            <column name="base_annual_interest_rate" type="DECIMAL(19, 6)"/>
            <column name="resolved_annual_interest_rate" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="rate_source" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="DATETIME"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet author="advancly" id="2">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_dynamic_rate_history"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
                     WHERE TABLE_SCHEMA = DATABASE()
                       AND TABLE_NAME = 'm_deposit_account_dynamic_rate_history'
                       AND CONSTRAINT_NAME = 'FK_deposit_account_dynamic_rate_history_account'
                </sqlCheck>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="savings_account_id" baseTableName="m_deposit_account_dynamic_rate_history"
                                 constraintName="FK_deposit_account_dynamic_rate_history_account" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account"/>
    </changeSet>

    <changeSet author="advancly" id="3">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_dynamic_rate_history"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
                     WHERE TABLE_SCHEMA = DATABASE()
                       AND TABLE_NAME = 'm_deposit_account_dynamic_rate_history'
                       AND CONSTRAINT_NAME = 'FK_deposit_account_dynamic_rate_history_transaction'
                </sqlCheck>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="savings_account_transaction_id" baseTableName="m_deposit_account_dynamic_rate_history"
                                 constraintName="FK_deposit_account_dynamic_rate_history_transaction" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account_transaction"/>
    </changeSet>

    <changeSet author="advancly" id="4">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_dynamic_rate_history"/>
                <not>
                    <indexExists indexName="IDX_deposit_account_dynamic_rate_history_account"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_deposit_account_dynamic_rate_history_account" tableName="m_deposit_account_dynamic_rate_history">
            <column name="savings_account_id"/>
            <column name="transaction_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
