<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!--
        Dynamic Deposit accounts/products with withhold_tax = true previously always had tax withheld on every
        interest posting, regardless of withhold_tax_posting_type_enum (DynamicDepositAccount.isWithHoldTaxApplicable()
        used to ignore posting type entirely). Now that dynamic deposit honours the same posting-type gate as
        Fixed/Recurring Deposit, existing dynamic deposit rows with a null posting type must be backfilled to
        INTEREST_POSTING (2) to preserve their prior behaviour. Changeset 0001 already backfilled
        m_deposit_product_term_and_preclosure / m_deposit_account_term_and_preclosure to MATURITY (1) for
        Fixed/Recurring Deposit, but ran before Dynamic Deposit existed on this branch (added in 0004/0005), so it
        never covered deposit_type_enum = 500 rows, and being already-executed it will not run again.
    -->

    <!-- Backfill dynamic deposit product rows to INTEREST_POSTING (2) where withhold tax is enabled -->
    <changeSet author="advancly" id="1">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_deposit_product_term_and_preclosure" columnName="withhold_tax_posting_type_enum"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_deposit_product_term_and_preclosure dpt
                JOIN m_savings_product sp ON dpt.savings_product_id = sp.id
                WHERE sp.deposit_type_enum = 500
                AND sp.withhold_tax = true
                AND dpt.withhold_tax_posting_type_enum IS NULL
            </sqlCheck>
        </preConditions>
        <sql>
            UPDATE m_deposit_product_term_and_preclosure dpt
            JOIN m_savings_product sp ON dpt.savings_product_id = sp.id
            SET dpt.withhold_tax_posting_type_enum = 2
            WHERE sp.deposit_type_enum = 500
            AND sp.withhold_tax = true
            AND dpt.withhold_tax_posting_type_enum IS NULL
        </sql>
    </changeSet>

    <!-- Backfill dynamic deposit account rows to INTEREST_POSTING (2) where withhold tax is enabled -->
    <changeSet author="advancly" id="2">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_deposit_account_term_and_preclosure" columnName="withhold_tax_posting_type_enum"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_deposit_account_term_and_preclosure dat
                JOIN m_savings_account sa ON dat.savings_account_id = sa.id
                WHERE sa.deposit_type_enum = 500
                AND sa.withhold_tax = true
                AND dat.withhold_tax_posting_type_enum IS NULL
            </sqlCheck>
        </preConditions>
        <sql>
            UPDATE m_deposit_account_term_and_preclosure dat
            JOIN m_savings_account sa ON dat.savings_account_id = sa.id
            SET dat.withhold_tax_posting_type_enum = 2
            WHERE sa.deposit_type_enum = 500
            AND sa.withhold_tax = true
            AND dat.withhold_tax_posting_type_enum IS NULL
        </sql>
    </changeSet>

</databaseChangeLog>
