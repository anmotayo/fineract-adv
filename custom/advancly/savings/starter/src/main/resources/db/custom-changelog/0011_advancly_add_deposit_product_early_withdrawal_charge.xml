<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Phase 4, implementation plan Section 2: gate flag for the early-withdrawal penalty mechanism. -->
    <changeSet author="advancly" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_deposit_product_dynamic_detail" columnName="early_withdrawal_penalty_enabled"/>
            </not>
        </preConditions>
        <addColumn tableName="m_deposit_product_dynamic_detail">
            <column name="early_withdrawal_penalty_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Classifier table marking which existing m_savings_product_charge row is the early-withdrawal penalty. -->
    <changeSet author="advancly" id="2">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_deposit_product_early_withdrawal_charge"/>
            </not>
        </preConditions>
        <createTable tableName="m_deposit_product_early_withdrawal_charge">
            <column name="savings_product_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_deposit_product_early_withdrawal_charge"/>
            </column>
            <column name="charge_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_deposit_product_early_withdrawal_charge"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Composite FK to m_savings_product_charge(savings_product_id, charge_id): the database itself guarantees the -->
    <!-- selected charge is attached to the product, so the Java validation can never be bypassed by a direct write. -->
    <changeSet author="advancly" id="3">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_product_early_withdrawal_charge"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="FK_deposit_product_early_withdrawal_charge_product_charge"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="savings_product_id,charge_id"
                                 baseTableName="m_deposit_product_early_withdrawal_charge"
                                 constraintName="FK_deposit_product_early_withdrawal_charge_product_charge"
                                 onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="savings_product_id,charge_id"
                                 referencedTableName="m_savings_product_charge"/>
    </changeSet>

</databaseChangeLog>
