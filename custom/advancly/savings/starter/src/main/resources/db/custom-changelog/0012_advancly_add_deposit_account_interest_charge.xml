<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Early-withdrawal interest-based charges (implementation plan Section 11). Rows are created PENDING on early -->
    <!-- withdrawal and linked to both transactions during the next interest posting (Section 10 steps 7-8).        -->
    <!-- No is_reversed column of its own - reversal state is owned by the linked transactions (Section 8 rule 5).   -->
    <changeSet author="advancly" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_deposit_account_interest_charge"/>
            </not>
        </preConditions>
        <createTable tableName="m_deposit_account_interest_charge">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_deposit_account_interest_charge"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="withdrawal_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="savings_account_charge_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="charge_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="interest_posting_transaction_id" type="BIGINT"/>
            <column name="interest_charge_transaction_id" type="BIGINT"/>
            <column name="interest_period_start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="interest_period_end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="interest_amount_basis" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="charge_percentage" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="charge_amount" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="DATETIME"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet author="advancly" id="2">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_interest_charge"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
                     WHERE TABLE_SCHEMA = DATABASE()
                       AND TABLE_NAME = 'm_deposit_account_interest_charge'
                       AND CONSTRAINT_NAME = 'FK_deposit_account_interest_charge_account'
                </sqlCheck>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="savings_account_id" baseTableName="m_deposit_account_interest_charge"
                                 constraintName="FK_deposit_account_interest_charge_account" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account"/>
    </changeSet>

    <changeSet author="advancly" id="3">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_interest_charge"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
                     WHERE TABLE_SCHEMA = DATABASE()
                       AND TABLE_NAME = 'm_deposit_account_interest_charge'
                       AND CONSTRAINT_NAME = 'FK_deposit_account_interest_charge_withdrawal_txn'
                </sqlCheck>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="withdrawal_transaction_id" baseTableName="m_deposit_account_interest_charge"
                                 constraintName="FK_deposit_account_interest_charge_withdrawal_txn" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account_transaction"/>
    </changeSet>

    <changeSet author="advancly" id="4">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_interest_charge"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
                     WHERE TABLE_SCHEMA = DATABASE()
                       AND TABLE_NAME = 'm_deposit_account_interest_charge'
                       AND CONSTRAINT_NAME = 'FK_deposit_account_interest_charge_posting_txn'
                </sqlCheck>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="interest_posting_transaction_id" baseTableName="m_deposit_account_interest_charge"
                                 constraintName="FK_deposit_account_interest_charge_posting_txn" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account_transaction"/>
    </changeSet>

    <changeSet author="advancly" id="5">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_interest_charge"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
                     WHERE TABLE_SCHEMA = DATABASE()
                       AND TABLE_NAME = 'm_deposit_account_interest_charge'
                       AND CONSTRAINT_NAME = 'FK_deposit_account_interest_charge_charge_txn'
                </sqlCheck>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="interest_charge_transaction_id" baseTableName="m_deposit_account_interest_charge"
                                 constraintName="FK_deposit_account_interest_charge_charge_txn" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account_transaction"/>
    </changeSet>

    <changeSet author="advancly" id="6">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_interest_charge"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
                     WHERE TABLE_SCHEMA = DATABASE()
                       AND TABLE_NAME = 'm_deposit_account_interest_charge'
                       AND CONSTRAINT_NAME = 'FK_deposit_account_interest_charge_account_charge'
                </sqlCheck>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="savings_account_charge_id" baseTableName="m_deposit_account_interest_charge"
                                 constraintName="FK_deposit_account_interest_charge_account_charge" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account_charge"/>
    </changeSet>

    <changeSet author="advancly" id="7">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_interest_charge"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM information_schema.KEY_COLUMN_USAGE
                     WHERE TABLE_SCHEMA = DATABASE()
                       AND TABLE_NAME = 'm_deposit_account_interest_charge'
                       AND CONSTRAINT_NAME = 'FK_deposit_account_interest_charge_charge'
                </sqlCheck>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="charge_id" baseTableName="m_deposit_account_interest_charge"
                                 constraintName="FK_deposit_account_interest_charge_charge" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_charge"/>
    </changeSet>

    <!-- Backs the pending-row lookup during interest posting: (account, pending, period end date). -->
    <changeSet author="advancly" id="8">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_account_interest_charge"/>
                <not>
                    <indexExists indexName="IDX_deposit_account_interest_charge_account_period"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_deposit_account_interest_charge_account_period" tableName="m_deposit_account_interest_charge">
            <column name="savings_account_id"/>
            <column name="interest_period_end_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
