<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- m_deposit_product_early_withdrawal_charge is a pure classifier keyed to m_savings_product_charge, not
         Dynamic-Deposit-specific, and should not read as if it were. See 0015's header for why this is a new,
         additive renameTable changeset rather than an edit to 0011, which has already run against real data.
         FK constraint name is deliberately left unchanged - purely cosmetic. -->
    <changeSet author="advancly" id="1">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_product_early_withdrawal_charge"/>
                <not>
                    <tableExists tableName="m_savings_product_early_withdrawal_charge"/>
                </not>
            </and>
        </preConditions>
        <renameTable oldTableName="m_deposit_product_early_withdrawal_charge"
                     newTableName="m_savings_product_early_withdrawal_charge"/>
    </changeSet>

    <changeSet author="advancly" id="2">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_savings_product_early_withdrawal_charge"
                              columnName="early_withdrawal_charge_mode_enum"/>
            </not>
        </preConditions>
        <addColumn tableName="m_savings_product_early_withdrawal_charge">
            <column name="early_withdrawal_charge_mode_enum" type="SMALLINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
