<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog-4.1.xsd">

    <changeSet author="advancly" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_adv_charge_interest_rule"/>
            </not>
        </preConditions>
        <createTable tableName="m_adv_charge_interest_rule">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_adv_charge_interest_rule"/>
            </column>
            <column name="charge_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="interest_basis_mode_enum" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="custom_period_reapply_policy_enum" type="SMALLINT"/>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="DATETIME"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet author="advancly" id="2">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_adv_charge_interest_rule"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="FK_adv_charge_interest_rule_charge"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="charge_id" baseTableName="m_adv_charge_interest_rule"
                                 constraintName="FK_adv_charge_interest_rule_charge" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_charge"/>
    </changeSet>

    <changeSet author="advancly" id="3">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_adv_charge_interest_rule"/>
                <not>
                    <uniqueConstraintExists tableName="m_adv_charge_interest_rule"
                                            constraintName="UNQ_adv_charge_interest_rule_charge"/>
                </not>
            </and>
        </preConditions>
        <addUniqueConstraint columnNames="charge_id" constraintName="UNQ_adv_charge_interest_rule_charge"
                             tableName="m_adv_charge_interest_rule"/>
    </changeSet>

    <changeSet author="advancly" id="4">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_adv_charge_interest_rule"/>
                <not>
                    <indexExists indexName="IDX_adv_charge_interest_rule_mode"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_adv_charge_interest_rule_mode" tableName="m_adv_charge_interest_rule">
            <column name="interest_basis_mode_enum"/>
        </createIndex>
    </changeSet>

    <changeSet author="advancly" id="5">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_deposit_interest_charge_application"/>
            </not>
        </preConditions>
        <createTable tableName="m_deposit_interest_charge_application">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_deposit_interest_charge_application"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="charge_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="withdrawal_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="interest_charge_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="selected_from_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="selected_to_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="interest_basis_mode_enum" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="custom_period_reapply_policy_enum" type="SMALLINT"/>
            <column name="percentage" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="original_basis_amount" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="previously_consumed_amount" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="applied_amount" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="correction_of_application_id" type="BIGINT"/>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="DATETIME"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet author="advancly" id="6">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="FK_deposit_interest_charge_app_account"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="savings_account_id" baseTableName="m_deposit_interest_charge_application"
                                 constraintName="FK_deposit_interest_charge_app_account" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account"/>
    </changeSet>

    <changeSet author="advancly" id="7">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="FK_deposit_interest_charge_app_charge"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="charge_id" baseTableName="m_deposit_interest_charge_application"
                                 constraintName="FK_deposit_interest_charge_app_charge" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_charge"/>
    </changeSet>

    <changeSet author="advancly" id="8">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="FK_deposit_interest_charge_app_withdrawal_txn"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="withdrawal_transaction_id" baseTableName="m_deposit_interest_charge_application"
                                 constraintName="FK_deposit_interest_charge_app_withdrawal_txn" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account_transaction"/>
    </changeSet>

    <changeSet author="advancly" id="9">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="FK_deposit_interest_charge_app_charge_txn"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="interest_charge_transaction_id" baseTableName="m_deposit_interest_charge_application"
                                 constraintName="FK_deposit_interest_charge_app_charge_txn" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_savings_account_transaction"/>
    </changeSet>

    <changeSet author="advancly" id="10">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <foreignKeyConstraintExists foreignKeyName="FK_deposit_interest_charge_app_correction"/>
                </not>
            </and>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="correction_of_application_id" baseTableName="m_deposit_interest_charge_application"
                                 constraintName="FK_deposit_interest_charge_app_correction" onDelete="RESTRICT" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_deposit_interest_charge_application"/>
    </changeSet>

    <changeSet author="advancly" id="11">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <indexExists indexName="IDX_deposit_interest_charge_app_account_charge_date"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_deposit_interest_charge_app_account_charge_date"
                     tableName="m_deposit_interest_charge_application">
            <column name="savings_account_id"/>
            <column name="charge_id"/>
            <column name="transaction_date"/>
        </createIndex>
    </changeSet>

    <changeSet author="advancly" id="12">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <indexExists indexName="IDX_deposit_interest_charge_app_selected_period"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_deposit_interest_charge_app_selected_period"
                     tableName="m_deposit_interest_charge_application">
            <column name="savings_account_id"/>
            <column name="charge_id"/>
            <column name="selected_from_date"/>
            <column name="selected_to_date"/>
        </createIndex>
    </changeSet>

    <changeSet author="advancly" id="13">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <indexExists indexName="IDX_deposit_interest_charge_app_withdrawal"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_deposit_interest_charge_app_withdrawal"
                     tableName="m_deposit_interest_charge_application">
            <column name="withdrawal_transaction_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="advancly" id="14">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <indexExists indexName="IDX_deposit_interest_charge_app_charge_txn"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_deposit_interest_charge_app_charge_txn"
                     tableName="m_deposit_interest_charge_application">
            <column name="interest_charge_transaction_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="advancly" id="15">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_deposit_interest_charge_application"/>
                <not>
                    <indexExists indexName="IDX_deposit_interest_charge_app_correction"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_deposit_interest_charge_app_correction"
                     tableName="m_deposit_interest_charge_application">
            <column name="correction_of_application_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="advancly" id="16">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_adv_charge_interest_rule"/>
                <tableExists tableName="m_savings_product_early_withdrawal_charge"/>
            </and>
        </preConditions>
        <sql>
            insert into m_adv_charge_interest_rule
                (charge_id, interest_basis_mode_enum, custom_period_reapply_policy_enum, created_by, created_on_utc,
                 last_modified_by, last_modified_on_utc)
            select distinct spc.charge_id,
                   case when spc.early_withdrawal_charge_mode_enum = 2 then 1 else 2 end,
                   case when spc.early_withdrawal_charge_mode_enum = 1 then 1 else null end,
                   1,
                   utc_timestamp(),
                   1,
                   utc_timestamp()
              from m_savings_product_early_withdrawal_charge spc
             where not exists (
                   select 1
                     from m_adv_charge_interest_rule rule
                    where rule.charge_id = spc.charge_id
             )
        </sql>
    </changeSet>

</databaseChangeLog>
