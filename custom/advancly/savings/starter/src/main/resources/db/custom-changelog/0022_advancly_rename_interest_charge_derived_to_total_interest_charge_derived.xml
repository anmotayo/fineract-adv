<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   logicalFilePath="db/changelog/tenant/module/savings/parts/parts/2005_rename_interest_charge_derived_to_total_interest_charge_derived.xml"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_savings_account" columnName="total_interest_charge_derived"/>
            </not>
        </preConditions>
        <addColumn tableName="m_savings_account">
            <column name="total_interest_charge_derived" type="DECIMAL(19, 6)" defaultValueComputed="NULL"/>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="m_savings_account" columnName="interest_based_charge_posted_derived"/>
                <columnExists tableName="m_savings_account" columnName="total_interest_charge_derived"/>
            </and>
        </preConditions>
        <sql>
            update m_savings_account
               set total_interest_charge_derived = interest_based_charge_posted_derived
             where interest_based_charge_posted_derived is not null
        </sql>
    </changeSet>

    <changeSet author="fineract" id="3">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="m_savings_account" columnName="interest_based_charge_derived"/>
                <columnExists tableName="m_savings_account" columnName="total_interest_charge_derived"/>
            </and>
        </preConditions>
        <sql>
            update m_savings_account
               set total_interest_charge_derived = interest_based_charge_derived
             where total_interest_charge_derived is null
               and interest_based_charge_derived is not null
        </sql>
    </changeSet>

    <changeSet author="fineract" id="4">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_savings_account" columnName="interest_based_charge_posted_derived"/>
        </preConditions>
        <dropColumn tableName="m_savings_account" columnName="interest_based_charge_posted_derived"/>
    </changeSet>

    <changeSet author="fineract" id="5">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_savings_account" columnName="interest_based_charge_derived"/>
        </preConditions>
        <dropColumn tableName="m_savings_account" columnName="interest_based_charge_derived"/>
    </changeSet>
</databaseChangeLog>
