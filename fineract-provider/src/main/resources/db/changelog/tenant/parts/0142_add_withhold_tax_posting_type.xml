<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Add withhold_tax_posting_type_enum to m_deposit_product_term_and_preclosure -->
    <changeSet author="fineract" id="1">
        <addColumn tableName="m_deposit_product_term_and_preclosure">
            <column name="withhold_tax_posting_type_enum" type="INT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Add withhold_tax_posting_type_enum to m_deposit_account_term_and_preclosure -->
    <changeSet author="fineract" id="2">
        <addColumn tableName="m_deposit_account_term_and_preclosure">
            <column name="withhold_tax_posting_type_enum" type="INT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Update existing product records to default value (1 = MATURITY) where withhold tax is enabled -->
    <changeSet author="fineract" id="3">
        <sql>
            UPDATE m_deposit_product_term_and_preclosure dpt
            JOIN m_savings_product sp ON dpt.savings_product_id = sp.id
            SET dpt.withhold_tax_posting_type_enum = 1
            WHERE sp.withhold_tax = true
            AND dpt.withhold_tax_posting_type_enum IS NULL
        </sql>
    </changeSet>

    <!-- Update existing account records to default value (1 = MATURITY) where withhold tax is enabled -->
    <changeSet author="fineract" id="4">
        <sql>
            UPDATE m_deposit_account_term_and_preclosure dat
            JOIN m_savings_account sa ON dat.savings_account_id = sa.id
            SET dat.withhold_tax_posting_type_enum = 1
            WHERE sa.withhold_tax = true
            AND dat.withhold_tax_posting_type_enum IS NULL
        </sql>
    </changeSet>

</databaseChangeLog>